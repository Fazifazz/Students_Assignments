# Base URL of the SpendWise API.
# Leave as /api in development — the Vite dev server proxies it to the backend.
# In production set the full deployed API origin, e.g. https://spendwise-api.onrender.com
VITE_API_URL=/api

# Target the Vite dev proxy forwards /api to
VITE_PROXY_TARGET=http://localhost:5000
