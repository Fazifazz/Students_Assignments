# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas connection string or local mongodb://127.0.0.1:27017/spendwise)
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=spendwise_token
RESET_TOKEN_TTL_MINUTES=60

# CORS allowlist — comma separated origins
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional SMTP for password reset emails.
# Leave blank to disable email delivery — the API then reports emailSent: false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@spendwise.local
